// String values using the "${VAR}" placeholder syntax will be replaced with
// the referenced environment variable.
{
    tz: "${TZ}",
    io: {
        port: 8081,
        addr: "0.0.0.0",
        path: '/ws',
    },
    logging: {
        level: "trace"
    },
    mail: {
        // JMAP API endpoint for mail operations.
        api_url: 'https://api.fastmail.com/jmap/api',
        // JMAP session discovery URL.
        session_url: 'https://api.fastmail.com/jmap/session',
        // API token for authentication. Generate in Fastmail settings.
        api_token: "${JMAP_API_TOKEN}",
    },
    webui: {
        port: 8080,
        addr: "0.0.0.0",
    },
    postgres: {
        port: "${POSTGRES_PORT}",
        hostname: "${POSTGRES_HOSTNAME}",
        database: "${POSTGRES_DATABASE}",
        username: "${POSTGRES_USERNAME}",
        password: "${POSTGRES_PASSWORD}",
    },
    models: {
        // Conversational session model used to generate responses to user
        // queries. Use models optimized for agentic workflows if possible.
        session: {
            // For now, the only supported adapter is 'openai'.
            adapter: 'openai',
            options: {
                model: "deepseek/deepseek-v4-pro",
                api_key: "${TENSORIX_API_KEY}",
                // Optional. Use to override the default base URL when making requests
                // to OpenAI-compatible inference providers.
                base_url: 'https://api.tensorix.ai/v1',
                // Extra options passed to the inference provider at query time.
                // Use to pass provider-specific options such as `provider` selection
                // criteria for OpenRouter.
                extras: {},
            },
            max_output_size: 20000,
            max_context_size: 1000000,
        },
        // Embedding model used to compute vector representations of
        // continuity records and similarity queries. Use a model that
        // supports at least 1536 dimensions.
        embedding: {
            // For now, the only supported adapter is 'openai'.
            adapter: 'openai',
            options: {
                model: 'qwen/qwen3-embedding-8b',
                api_key: "${OPENROUTER_API_KEY}",
                // Optional. Use to override the default base URL when making requests
                // to OpenAI-compatible inference providers.
                base_url: 'https://openrouter.ai/api/v1',
                // Extra options passed to the inference provider at query time.
                // Use to pass provider-specific options such as `provider` selection
                // criteria for OpenRouter. Optional.
                extras: {},
            },
        },
    },
}
